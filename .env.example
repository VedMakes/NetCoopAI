# NetCoop AI Environment Configuration
# API Provider: OpenRouter (using free models)

# Place your OpenRouter API Key below:
OPENROUTER_API_KEY=

# Selected Free Model (defaults to nvidia/nemotron-3.5-lightning:free)
# Other free options:
# - liquid/lfm-2.5-2.6b:free
# - google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# OpenRouter Endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM Mode: off (deterministic default), auto (use OpenRouter if key set), on (require LLM)
NETCOOP_LLM_MODE=auto
