# NetCoop AI Environment Configuration
# API Provider: OpenRouter (using free models)

# Place your OpenRouter API Key below:
OPENROUTER_API_KEY=

# Selected Free Model (defaults to meta-llama/llama-3.3-70b-instruct:free)
# Other free options:
# - google/gemini-2.0-flash-exp:free
# - deepseek/deepseek-r1:free
# - mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenRouter Endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM Mode: off (deterministic default), auto (use OpenRouter if key set), on (require LLM)
NETCOOP_LLM_MODE=auto
